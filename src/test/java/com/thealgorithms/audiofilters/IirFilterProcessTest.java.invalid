package com.thealgorithms.audiofilters;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.assertj.core.api.Assertions;
import org.junit.experimental.categories.Category;

public class IirFilterProcessTest {
    @Test
    @Tag("valid")
    public void checkProcessingWithValidSampleValues() {
        IIRFilter iirFilter = new IIRFilter(3);
        double[] aCoeffs = {1.0, 0.3, -0.2, 0.1};
        double[] bCoeffs = {1.0, -0.3, 0.2, -0.1};
        iirFilter.setCoeffs(aCoeffs, bCoeffs);
      
        double sampleValue = 5.4;
        double expectedValue = 1.08;
        double actualValue = iirFilter.process(sampleValue);
        Assertions.assertThat(actualValue).isEqualTo(expectedValue);
    }
    
    @Test
    @Tag("invalid")
    public void checkCoefficientsDimensions() {
        IIRFilter iirFilter = new IIRFilter(3);
        double[] aCoeffs = {1.0, 0.3, -0.2};
        double[] bCoeffs = {1.0, -0.3, 0.2, -0.1};
        Assertions.assertThatThrownBy(() -> {
            iirFilter.setCoeffs(aCoeffs, bCoeffs);
        }).isInstanceOf(IllegalArgumentException.class)
        .hasMessageContaining("Coeffs must be of size" + aCoeffs.length);
    }
    @Test
    @Tag("valid")
    public void validateHistoryEffectOnProcess() {
        IIRFilter iirFilter = new IIRFilter(4);
        double[] aCoeffs = {1.0, 0.3, 0.2, -0.2, 0.1};
        double[] bCoeffs = {1.0, -0.3, -0.2, 0.2, -0.1};
        iirFilter.setCoeffs(aCoeffs, bCoeffs);
        
        iirFilter.process(3.1);
        iirFilter.process(2.6);
        double firstProcessResult = iirFilter.process(4.9);
        iirFilter.process(1.4);
        double secondProcessResult = iirFilter.process(4.9);
        
        Assertions.assertThat(firstProcessResult).isNotEqualTo(secondProcessResult);
    }
    @Test
    @Tag("invalid")
    public void checkZeroCoefficientsInACoeffsArray() {
        IIRFilter iirFilter = new IIRFilter(3);
        double[] aCoeffs = {0.0, 0.3, -0.2, 0.1};
        double[] bCoeffs = {1.0, -0.3, 0.2, -0.1};
        Assertions.assertThatThrownBy(() -> {
            iirFilter.setCoeffs(aCoeffs, bCoeffs);
        }).isInstanceOf(IllegalArgumentException.class)
        .hasMessageContaining("aCoeffs.get(0) must not be zero");
    }
}